{
  "name": "hide-files",
  "version": "1.0.3",
  "license": "MIT",
  "homepage": "https://github.com/ayuthmang/hide-files#readme",
  "bugs": {
    "url": "https://github.com/ayuthmang/hide-files/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ayuthmang/hide-files"
  },
  "bin": {
    "hide-files": "bin/hide-files.js"
  },
  "files": [
    "bin/**/*.js",
    "bin/**/*.d.ts",
    "src/**/*.js",
    "src/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "tsc --build --clean",
    "prepack": "npm run build",
    "publish:npm": "npm publish",
    "format": "prettier --write \"{src,bin}/**/*.ts\" --ignore-path .gitignore",
    "lint": "eslint \"{src,bin}/**/*.ts\" --ignore-path .gitignore",
    "lint:fix": "eslint \"{src,bin}/**/*.ts\" --ignore-path .gitignore --fix",
    "test": "jest",
    "test:watch": "jest --watchAll"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^9.4.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.3.1",
    "@types/node": "^18.11.9",
    "@typescript-eslint/eslint-plugin": "^5.45.1",
    "@typescript-eslint/parser": "^5.45.1",
    "eslint": "^8.29.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.3.1",
    "prettier": "^2.8.0",
    "ts-jest": "^29.0.3",
    "typescript": "^4.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.28.0"
}
